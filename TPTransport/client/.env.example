# /etc/bus-client/env
# Copy this file to /etc/bus-client/env and fill in the values.
# This file is sourced by systemd (EnvironmentFile=) — no 'export' keyword needed.
# Do NOT commit real tokens to version control.

# ── Required ────────────────────────────────────────────────────────────────
# Bearer token assigned by the admin interface (shown once at creation).
BUS_API_TOKEN=replace_me_with_real_token

# Base HTTPS URL of the tracking server (no trailing slash).
BUS_SERVER_URL=https://bus.example.com

# ── GPS ─────────────────────────────────────────────────────────────────────
GPSD_HOST=127.0.0.1
GPSD_PORT=2947

# ── Timing ──────────────────────────────────────────────────────────────────
LOOP_INTERVAL_S=5
HTTP_TIMEOUT_S=8

# ── Offline buffer ───────────────────────────────────────────────────────────
BUFFER_DB_PATH=/var/lib/bus-client/buffer.db
BUFFER_MAX_ENTRIES=1000

# ── TLS ─────────────────────────────────────────────────────────────────────
# Leave empty to use the system CA store.
# Set to a PEM file path for a self-signed / custom CA.
# TLS_CA_BUNDLE=/etc/ssl/certs/my-ca.pem

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_DIR=/var/log/bus-client
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=7
