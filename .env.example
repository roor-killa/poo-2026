# PostgreSQL
POSTGRES_DB=langmatinitje
POSTGRES_USER=creole
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Adminer
ADMINER_PORT=8080

# API FastAPI
API_KEY=changeme
API_PORT=8000

# Backend Laravel
# Générer avec : php artisan key:generate --show
# ou : echo "base64:$(openssl rand -base64 32)"
LARAVEL_APP_KEY=base64:CHANGE_ME_RUN_php_artisan_key_generate
LARAVEL_PORT=8001

# Frontend Next.js
FRONTEND_PORT=3000

# Chatbot Fèfèn — RAG (optionnel)
# Générer sur https://huggingface.co/settings/tokens (Read)
HF_TOKEN=
# Modèle par défaut : mistralai/Mixtral-8x7B-Instruct-v0.1
# FEFEN_MODEL=mistralai/Mixtral-8x7B-Instruct-v0.1
