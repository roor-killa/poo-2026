# Example environment file (do not commit secrets in .env)
# Copy to .env and adjust as needed.

# PostgreSQL (host -> container mapping is configured in docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5111
POSTGRES_DB=poo_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host ports
FRONTEND_PORT=8111
NGINX_PORT=81
